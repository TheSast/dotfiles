include "xdg.kdl"
include optional=true "host.kdl"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

clipboard {
    disable-primary
}

input {
    disable-power-key-handling

    keyboard {
        xkb {
            layout "us"
            options "caps:backspace,compose:ralt"
        }
    }

    focus-follows-mouse
    warp-mouse-to-focus
}

cursor {
    hide-after-inactive-ms 10000
}

gestures {
    hot-corners {
        off
    }
}

layout {
    empty-workspace-above-first
    gaps 10
    border {
        off
    }
    focus-ring {
        off
    }
    background-color "transparent"
}

overview {
    zoom 0.60
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    background-effect {
        xray false
        blur true
    }

    popups {
        opacity 0.9
        background-effect {
            xray false
            blur true
        }
    }
}

window-rule {
    match is-focused=true
    opacity 0.95
}

window-rule {
    match is-focused=false
    opacity 0.85
}

layer-rule {
    match namespace="^noctalia-(backdrop|overview.*)$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
    background-effect {
        xray false
    }
}

animations {
    slowdown 1.5
    // 0.05, 0.9, 0.1, 1.05
}

include optional=true "binds.kdl"

binds {
    Mod+G { spawn-sh "$XDG_CONFIG_HOME/scripts/niri-toggle-binds.sh"; }
}

debug {
    honor-xdg-activation-with-invalid-serial
}

window-rule {
    match app-id="at.yrlf.wl_mirror"
    open-fullscreen true
    open-focused false
    block-out-from "screencast"
}

window-rule {
    match app-id="xdg-desktop-portal-gtk"
    open-floating false
}

window-rule {
    match app-id="xdg-desktop-portal-gnome" title="Share Screen"
    open-floating false
}

window-rule {
    match app-id="electron" title="Display capture"
    open-floating false
}

window-rule {
    match app-id="electron" title=r#"^Allow this page to access '.*'\?$"#
    open-floating false
}
