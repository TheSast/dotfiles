xwayland-satellite {
    off
}

switch-events {
    lid-close { spawn "sh" "-c" "loginctl lock-session; noctalia msg caffeine-disable; niri msg action power-off-monitors"; }
    lid-open { spawn "sh" "-c" "niri msg action power-on-monitors"; }
}

output "eDP-1" {
    scale 1.6
    position x=0 y=0
    focus-at-startup
    variable-refresh-rate
}

input {
    touchpad {
        tap
        dwt
        natural-scroll
        drag-lock
    }
}
