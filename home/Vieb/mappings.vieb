map <S-F5> <refreshTabWithoutCache>
unmap <C-I>
unmap <C-q>
unmap <F10>
unmap <F11>
unmap <F12>
unmap <F1>
unmap <F2>
unmap <F3>
unmap <F4>
unmap <F6>
unmap <F7>
unmap <F8>
unmap <F9>

nmap <Bar> <:vsplit>
nmap <Bslash> <:split>
nmap <C-Down> <decreaseHeightSplitWindow>
nmap <C-Left> <decreaseWidthSplitWindow>
nmap <C-Right> <increaseWidthSplitWindow>
nmap <C-Up> <increaseHeightSplitWindow>
nmap <C-h> <toLeftSplitWindow>
nmap <C-j> <toBottomSplitWindow>
nmap <C-k> <toTopSplitWindow>
nmap <C-l> <toRightSplitWindow>
nmap <Esc> <:nohlsearch>
nmap <Space>bn <:tabnew>
nmap <Space>c <:close>
nmap <Space>fb <toCommandMode>b<Space>
nmap <Space>ff <:tabnew><toExploreMode>
nmap <Space>q <:hide>
nmap <Space>z <:set guifullscreennavbar!always|oninput><:set guifullscreentabbar!always|onupdate>
nmap <lt>b <moveTabBackward>
nmap >b <moveTabForward>
nmap S <startFollowNewTab>
nmap [b <previousTab>
nmap ]b <nextTab>
nmap s <startFollowCurrentTab>
nmap ys <startFollowCopyLink>
nmap yv <p.copyText>
nunmap F
nunmap T
nunmap ZZ
nunmap b
nunmap c
nunmap d
nunmap f
nunmap r
nunmap t
nunmap w
nunmap x
nunmap yf
nunmap! ;

imapclear!
imap <Esc> <toNormalMode>
inoremap <A-Esc> <Esc>

cmapclear!
