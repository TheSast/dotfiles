" Options
colorscheme dyn-verticaltabs
set nativetheme=system
set clearhistoryinterval=2days
set containercolors=
set containercolors+=temp\d+~#ff0
set containercolors+=^discord$~#4D58CA
set dialogconfirm=notifyshow
set guiscrollbar=never
set mapsuggestposition=bottomright
set notificationposition=topright
set permissionnotifications=ask
set permissionpersistentstorage=ask
set permissionsallowed+=bbb.pulsar.gg~hid
set permissionsallowed+=keyboard.frame.work~hid
set permissionsallowed+=wootility.io~hid
set permissionscreenwakelock=ask
set permissionsensors=ask
set permissionunknown=ask
set replacestartup=newtab
set searchengine=
set searchengine+=https://duckduckgo.com/?q=%s
set searchengine+=https://startpage.com/sp/search?query=%s
set searchengine+=https://search.brave.com/search?q=%s
" set searchengine+=https://searx.tiekoetter.com/search?q=%s
set splitbelow
set splitright
set sponsorblock
set suggestbouncedelay=150
set suspendtimeout=600000
set vimcommand=neovide

" Mappings
source mappings.vieb

" Commands
command viewmarkdown <toggleMarkdownViewer>
command viewreader <toggleReaderView>
command viewsource <toggleSourceViewer>

